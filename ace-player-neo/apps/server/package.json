    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@ace/shared": "workspace:*",
    "fastify": "5.12.5",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6"
  }
}
