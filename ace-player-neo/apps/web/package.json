{
  "name": "@ace/web",
  "private": true,
  "version": "0.8.2",
  "type": "module",
  "description": "Web de Ace Player Neo v2 (Vite + React + TypeScript)",
  "sideEffects": [
    "**/*.css",
    "./src/main.tsx",
    "./src/**/demo.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "icons": "node scripts/icons.mjs",
    "capturas": "node scripts/capturas.mjs",
    "revision": "node scripts/revision-visual.mjs",
    "rendimiento": "node scripts/rendimiento.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ace/shared": "workspace:*",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-virtual": "3.14.13",
    "hls.js": "1.7.3",
    "mpegts.js": "1.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "lighthouse": "13.5.0",
    "vite": "8.3.0"
  }
}
