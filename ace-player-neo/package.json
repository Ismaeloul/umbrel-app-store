{
  "name": "ace-player-neo",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Ace Player Neo v2: backend, web y app iOS del reproductor AceStream del Umbrel",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ace/server --filter @ace/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:deploy": "vitest run --config vitest.config.ts",
    "test:nginx": "node scripts/test-nginx-docker.mjs",
    "test:shellcheck": "node scripts/test-shellcheck-docker.mjs",
    "test:contraste": "node scripts/contraste.mjs",
    "test:compose": "node scripts/test-compose-local.mjs",
    "typecheck:deploy": "tsc -p deploy/tsconfig.json",
    "local:prepare": "node deploy/local/prepare.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
