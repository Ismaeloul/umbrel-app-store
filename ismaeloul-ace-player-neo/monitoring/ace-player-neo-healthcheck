#!/usr/bin/env bash

set -u

PATH="/usr/local/bin:/usr/bin:/bin"

APP_ID="ismaeloul-ace-player-neo"
APP_DIR="${HOME}/umbrel/app-data/${APP_ID}"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/${APP_ID}-monitor"
STATUS_FILE="${STATE_DIR}/status.json"
LOG_FILE="${STATE_DIR}/health.log"
LOCK_FILE="${STATE_DIR}/health.lock"

mkdir -p "${STATE_DIR}"
chmod 700 "${STATE_DIR}"

if command -v flock >/dev/null 2>&1; then
  exec 9>"${LOCK_FILE}"
  flock -n 9 || exit 0
fi

checked_at="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
version="$(awk '/^version:/ { gsub(/["[:space:]]/, "", $2); print $2; exit }' "${APP_DIR}/umbrel-app.yml" 2>/dev/null)"
version="${version:-unknown}"
overall="ok"

mark_failed() {
  overall="failed"
}

# Pasarela de Umbrel -> nginx -> backend, sin sesion. /native/api/v1/ping es
# la unica ruta de la app (0.7.0 en adelante) que la pasarela deja pasar sin
# login (PROXY_AUTH_WHITELIST) y que el backend contesta sin token. Solo da
# "ok" si responde 200 con el JSON de la app y la version que dice el
# manifiesto: asi se sabe que los tres saltos funcionan y que corre la release
# instalada. Antes se pedia "/" y, sin sesion, la pasarela redirige al login
# aunque nginx o el backend esten caidos: daba "ok" siempre.
ping_response="$(curl -sS --max-time 8 -w '\n%{http_code}' http://127.0.0.1:7792/native/api/v1/ping 2>/dev/null || true)"
http_code="${ping_response##*$'\n'}"
http_code="${http_code:-000}"
ping_body="${ping_response%$'\n'*}"
running_version=""
if [ "${http_code}" = "200" ]; then
  running_version="$(printf '%s' "${ping_body}" | python3 -c 'import json, sys; d = json.load(sys.stdin); ok = d.get("ok") is True and d.get("app") == "ace-player-neo"; print(d.get("version", "")) if ok else sys.exit(1)' 2>/dev/null | tr -cd '0-9A-Za-z.+-' || true)"
fi
if [ "${http_code}" != "200" ]; then
  app_proxy="failed:${http_code}"
  mark_failed
elif [ -z "${running_version}" ]; then
  # 200 pero no es el ping de la app (por ejemplo, la pagina de login).
  app_proxy="failed:not-ace-player-neo"
  mark_failed
elif [ "${version}" != "unknown" ] && [ "${running_version}" != "${version}" ]; then
  app_proxy="failed:running-${running_version}"
  mark_failed
else
  app_proxy="ok:${http_code}"
fi

if python3 -m json.tool "${APP_DIR}/data/state.json" >/dev/null 2>&1; then
  app_state="ok"
else
  app_state="failed"
  mark_failed
fi

port_open() {
  timeout 3 bash -c "exec 3<>/dev/tcp/127.0.0.1/$1" >/dev/null 2>&1
}

if port_open 8621; then
  acestream="ok"
else
  acestream="failed"
  mark_failed
fi

# El comprobador no publica puerto (desde la 0.6.58) y su estado solo lo da el
# backend en /api/health o /api/v1/health, que piden el login de Umbrel (o el
# token de un dispositivo). Sin sesion, la pasarela contesta con la redireccion
# al login y esto salia "failed" siempre. Como el vigilante no puede saberlo, lo
# dice: "unknown", que no cuenta como fallo. El estado real se ve en la web
# (Ajustes > Salud).
if grep -q '^[[:space:]]*acestream_scanner:' "${APP_DIR}/docker-compose.yml" 2>/dev/null; then
  scanner="unknown"
else
  scanner="not-installed"
fi

if [ -d "${HOME}/umbrel/app-data/ollama" ]; then
  ollama_code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 8 http://127.0.0.1:11434/api/tags 2>/dev/null || true)"
  if [ "${ollama_code}" = "200" ]; then
    ollama="ok"
  else
    ollama="failed:${ollama_code:-000}"
    mark_failed
  fi
else
  ollama="not-installed"
fi

status_tmp="${STATUS_FILE}.tmp"
printf '{"checkedAt":"%s","overall":"%s","version":"%s","checks":{"appProxy":"%s","appState":"%s","aceStream":"%s","scanner":"%s","ollama":"%s"}}\n' \
  "${checked_at}" "${overall}" "${version}" "${app_proxy}" "${app_state}" \
  "${acestream}" "${scanner}" "${ollama}" >"${status_tmp}"
mv "${status_tmp}" "${STATUS_FILE}"

printf '%s overall=%s version=%s app_proxy=%s app_state=%s acestream=%s scanner=%s ollama=%s\n' \
  "${checked_at}" "${overall}" "${version}" "${app_proxy}" "${app_state}" \
  "${acestream}" "${scanner}" "${ollama}" >>"${LOG_FILE}"

if [ "$(wc -c <"${LOG_FILE}")" -gt 1048576 ]; then
  tail -n 1000 "${LOG_FILE}" >"${LOG_FILE}.tmp"
  mv "${LOG_FILE}.tmp" "${LOG_FILE}"
fi

if [ "${overall}" != "ok" ]; then
  exit 1
fi
