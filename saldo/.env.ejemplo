# OJO: esto es opcional. Lo normal es configurar el correo DESDE LA APP, en el
# engranaje del panel → Ajustes, y lo que guardes alli manda sobre lo de aqui.
# Este fichero sirve para dejarlo preconfigurado de antemano.
#
# Copia este fichero a `.env` y rellena lo tuyo. `.env` esta en .gitignore.
# Sin correo configurado la app funciona igual: los avisos salen por el log y
# se quedan pendientes, y saldran el dia que configures esto.

# --- Correo (Gmail) -------------------------------------------------------
# La clave NO es la de tu cuenta de Google: es una CONTRASENA DE APLICACION,
# que se genera en la cuenta de Google con la verificacion en dos pasos puesta.
SALDO_SMTP_HOST=smtp.gmail.com
SALDO_SMTP_PUERTO=587
SALDO_SMTP_SEGURO=0
SALDO_SMTP_USUARIO=tu-cuenta@gmail.com
SALDO_SMTP_CLAVE=xxxxxxxxxxxxxxxx
SALDO_CORREO_DE=Saldo <tu-cuenta@gmail.com>
SALDO_CORREO_PARA=tu-cuenta@gmail.com

# --- Cuando avisar --------------------------------------------------------
# Avisa cuando a una cuenta le queden estos dias de saldo o menos.
SALDO_AVISO_DIAS=30
# Avisa cuando una prueba gratuita pase a cobro dentro de estos dias.
SALDO_AVISO_PRUEBA_DIAS=7

# --- Tarea diaria ---------------------------------------------------------
# Hora local a la que se aplican los cobros vencidos y salen los avisos.
SALDO_HORA_TAREA=3
# A 0 se apagan la tarea diaria y la materializacion de arranque.
SALDO_TAREAS_DE_FONDO=1

TZ=Europe/Madrid
